#Connection parameters, please enter Sharepoint online admin center url here
$AdminURL = "https://astrid21vtest-admin.sharepoint.cn"
 
#Get Credentials to connect
$Cred= Get-Credential -Message "Enter the Admin Credentials"
$Credentials = New-Object -TypeName System.Management.Automation.PSCredential -argumentlist $Cred.Username, $Cred.Password

Connect-SPOService -Url $AdminURL -Credential $Credentials

#Create M365 group for Sharepoint site
Import-Csv "C:\Sample.csv" | ForEach-Object {Set-SPOSiteOffice365Group -Site $_.Site -DisplayName $_.DisplayName -Alias $_.Alias}
